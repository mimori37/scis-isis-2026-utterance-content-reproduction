# ============================================================
# study03 の実行に使った make ターゲット。研究リポジトリの Makefile からの抜粋である。
# ターゲットの中身は変えていない。
#
# 抜粋した理由。元の Makefile には、この研究より前の API を使う工程（src/run_analysis.py
# など）と study02 の工程も入っている。どちらも論文が報告した手続きではなく、参照先の
# スクリプトもこのリポジトリには無い。残すと、実際には通らない経路を読ませることになる。
#
# study03 は API を使わない。Web 版の一時チャットへ貼り、返答を手で戻す。
# replay_flow.py が貼る全文を組み立て、返答を解析して次の工程へ進める。
#   next   … いま貼る全文を _paste.txt へ書き出す
#   record … _reply.txt を取り込み、その工程の成果物を保存して次へ進める
# 発話セットのデータが要るので、このリポジトリだけでは動かない。手続きの記録である。
# ============================================================

# .venv があれば優先的に使う
PYTHON ?= $(shell [ -x .venv/bin/python ] && echo .venv/bin/python || echo python3)
export PYTHONPATH := src

# 発話セットの構築（原作の文字起こしから train/test を作る。study03 もこれを使う）
.PHONY: replay-build-sets
replay-build-sets:
	$(PYTHON) scripts/build_utterance_sets.py

# ============================================================
# study03: baseline-anchored replay（N=0=前回研究のキャラ付けプロンプト・評価3層）
#   CHARAGEN_STUDY=study03_baseline-replay に切替。2条件(N=0a/b)は別バッチ（COND でTSにラベル）。
#   詳細は experiments/study03_baseline-replay/DESIGN.md
#
#   # 条件A を gen0 baseline 直置きで開始
#   make replay3-init CHARA=experiments/study03_baseline-replay/N0_baseline/chara_prompt_A_h7_r10.md COND=condA
#   make replay3-next  TS=<batch>             # TS 省略時は最新バッチ
#   make replay3-record TS=<batch>            # analysis→design なしで gen_train から
#   make replay3-status TS=<batch>
#   make replay3-judge        A=0 B=4 TS=<batch> [SWAP=1]
#   make replay3-record-judge A=0 B=4 TS=<batch> [SWAP=1]
# ============================================================
A ?=
B ?=
SWAP ?=
CHARA ?=
COND ?=
TS ?=
GEN ?=
KEYS ?=
S3 := CHARAGEN_STUDY=study03_baseline-replay

.PHONY: replay3-init replay3-next replay3-record replay3-status replay3-judge replay3-record-judge replay3-rubric replay3-record-rubric

replay3-init:
	$(S3) $(PYTHON) src/replay_flow.py init $(if $(strip $(CHARA)),--chara $(CHARA),) $(if $(strip $(COND)),--cond $(COND),)

replay3-next:
	$(S3) $(PYTHON) src/replay_flow.py next $(if $(strip $(TS)),--ts $(TS),)

replay3-record:
	$(S3) $(PYTHON) src/replay_flow.py record $(if $(strip $(TS)),--ts $(TS),)

replay3-status:
	$(S3) $(PYTHON) src/replay_flow.py status $(if $(strip $(TS)),--ts $(TS),)

replay3-judge:
	$(S3) $(PYTHON) src/replay_flow.py judge --A $(A) --B $(B) $(if $(strip $(TS)),--ts $(TS),) $(if $(strip $(SWAP)),--swap,)

replay3-record-judge:
	$(S3) $(PYTHON) src/replay_flow.py record-judge --A $(A) --B $(B) $(if $(strip $(TS)),--ts $(TS),) $(if $(strip $(SWAP)),--swap,)

# 絶対rubric（モデル毎の単体評価）。まず KEYS=1 で内容要素キーを作り人手確認→各世代を GEN=n で採点。
#   make replay3-rubric KEYS=1 TS=<batch>            # gold から内容要素キーを列挙
#   make replay3-record-rubric KEYS=1 TS=<batch>     # → experiments/study03_baseline-replay/eval/ に保存（要人手確認）
#   make replay3-rubric GEN=0 TS=<batch>             # gen0 の test 生成を採点
#   make replay3-record-rubric GEN=0 TS=<batch>      # 平均 content再現率/style を表示・保存
replay3-rubric:
	$(S3) $(PYTHON) src/replay_flow.py rubric $(if $(strip $(TS)),--ts $(TS),) $(if $(strip $(KEYS)),--keys,) $(if $(strip $(GEN)),--gen $(GEN),)

replay3-record-rubric:
	$(S3) $(PYTHON) src/replay_flow.py record-rubric $(if $(strip $(TS)),--ts $(TS),) $(if $(strip $(KEYS)),--keys,) $(if $(strip $(GEN)),--gen $(GEN),)
